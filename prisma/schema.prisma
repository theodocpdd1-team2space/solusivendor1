generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VpsClientStatus {
  PENDING_PAYMENT
  WAITING_APPROVAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum VpsOrderStatus {
  DRAFT
  WAITING_PAYMENT
  WAITING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum VpsPackageType {
  NANO
  MICRO
  STARTUP
  STARTER
  PRO
  BUSINESS
}

enum VpsAppType {
  STATIC
  NODE
  NEXTJS
  LARAVEL
  OTHER
}

enum VpsProjectStatus {
  PENDING_SETUP
  PROVISIONING
  ONLINE
  ERROR
  SUSPENDED
  EXPIRED
}

enum VpsDomainType {
  DEFAULT
  CUSTOM
}

enum VpsDomainStatus {
  PENDING_DNS
  VERIFIED
  ACTIVE
  ERROR
}

enum VpsDatabaseType {
  POSTGRES
  MYSQL
}

enum VpsDatabaseStatus {
  REQUESTED
  PROVISIONING
  ACTIVE
  ERROR
  DISABLED
}

model User {
  id           String      @id @default(cuid())
  name         String?
  businessName String?
  email        String      @unique
  whatsapp     String?
  passwordHash String
  role         UserRole    @default(USER)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  vpsClients   VpsClient[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model VpsClient {
  id        String          @id @default(cuid())
  userId    String?         @unique
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  whatsapp  String
  status    VpsClientStatus @default(PENDING_PAYMENT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  orders       VpsOrder[]
  projects     VpsProject[]
  activityLogs VpsActivityLog[]

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model VpsOrder {
  id           String         @id @default(cuid())
  clientId     String
  client       VpsClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  packageType  VpsPackageType
  projectName  String
  appType      VpsAppType
  customDomain String?
  repoUrl      String?
  branch       String         @default("main")
  appPort      Int            @default(3000)
  notes        String?
  paymentProof String?
  status       VpsOrderStatus @default(WAITING_PAYMENT)
  amount       Int
  activeFrom   DateTime?
  activeUntil  DateTime?
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  projects     VpsProject[]
  activityLogs VpsActivityLog[]

  @@index([clientId])
  @@index([status])
  @@index([packageType])
  @@index([createdAt])
}

model VpsProject {
  id               String           @id @default(cuid())
  clientId         String
  client           VpsClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orderId          String?
  order            VpsOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  name             String
  slug             String
  packageType      VpsPackageType
  appType          VpsAppType
  status           VpsProjectStatus @default(PENDING_SETUP)
  containerName    String?
  internalPort     Int?
  appPort          Int              @default(3000)
  memoryLimit      String?
  cpuLimit         String?
  storageLimit     String?
  appUrl           String?
  defaultSubdomain String?
  customDomain     String?
  dnsTarget        String?
  activeUntil      DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  domains      VpsDomain[]
  repository   VpsRepository?
  database     VpsDatabase?
  activityLogs VpsActivityLog[]

  @@unique([slug])
  @@index([clientId])
  @@index([orderId])
  @@index([status])
  @@index([packageType])
  @@index([createdAt])
}

model VpsRepository {
  id             String     @id @default(cuid())
  projectId      String     @unique
  project        VpsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repoUrl        String?
  branch         String     @default("main")
  installCommand String?
  buildCommand   String?
  startCommand   String?
  appPort        Int        @default(3000)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([projectId])
}

model VpsDatabase {
  id               String            @id @default(cuid())
  projectId        String            @unique
  project          VpsProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type             VpsDatabaseType   @default(POSTGRES)
  status           VpsDatabaseStatus @default(REQUESTED)
  host             String?
  port             Int?
  dbName           String?
  dbUser           String?
  dbPassword       String?
  connectionString String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([type])
}

model VpsDomain {
  id        String          @id @default(cuid())
  projectId String
  project   VpsProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hostname  String
  type      VpsDomainType
  status    VpsDomainStatus @default(PENDING_DNS)
  dnsTarget String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([projectId])
  @@index([hostname])
  @@index([status])
}

model VpsActivityLog {
  id        String      @id @default(cuid())
  projectId String?
  project   VpsProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId  String?
  client    VpsClient?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  orderId   String?
  order     VpsOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type      String
  message   String
  createdAt DateTime    @default(now())

  @@index([projectId])
  @@index([clientId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model FreeRegistration {
  id              String  @id @default(cuid())
  ownerName       String
  businessName    String
  whatsapp        String
  city            String
  vendorType      String
  instagram       String?
  currentProblem  String?
  goal            String
  packageInterest String  @default("Free Vendor Hoki")
  notes           String?
  source          String  @default("solusivendor.com/free-register")
  status          String  @default("NEW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([whatsapp])
  @@index([status])
  @@index([createdAt])
}
